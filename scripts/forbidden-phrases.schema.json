{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Forbidden phrases config",
  "type": "object",
  "required": ["phrases"],
  "properties": {
    "description": { "type": "string" },
    "ignore": {
      "type": "array",
      "description": "Glob patterns (relative to dist/) skipped for ALL phrases. Supports **, *, ?.",
      "items": { "type": "string", "minLength": 1 }
    },
    "phrases": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          {
            "type": "object",
            "required": ["phrase"],
            "properties": {
              "phrase": { "type": "string", "minLength": 1 },
              "reason": { "type": "string" },
              "replacement": { "type": "string" },
              "caseInsensitive": { "type": "boolean", "default": false },
              "regex": { "type": "boolean", "default": false },
              "ignore": {
                "type": "array",
                "description": "Glob patterns (relative to dist/) skipped only for THIS phrase.",
                "items": { "type": "string", "minLength": 1 }
              }
            },
            "additionalProperties": false
          }
        ]
      }
    }
  }
}
